# ============================================================================
#  Internship Search Agent — environment configuration
#  Copy to .env and fill in what you have. EVERY key below is optional except
#  DATABASE_URL (which has a working default). The system runs with zero
#  credentials using the free, no-auth sources.
# ============================================================================

# ---- Core -----------------------------------------------------------------
DATABASE_URL=sqlite:///./data/internship.db
# Production example:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/internship
APP_HOST=127.0.0.1
APP_PORT=8000
# Public URL of the deployed dashboard. Digest links point here, so set it
# once deployed, e.g. https://internship-search.fly.dev
PUBLIC_BASE_URL=
# The dashboard uses accounts, not a shared password: sign up at /signup.
LOG_LEVEL=INFO
# JSON logs for production, console for dev
LOG_FORMAT=console
TIMEZONE=America/New_York

# ---- Notifications --------------------------------------------------------
# Telegram: message @BotFather -> /newbot -> copy token. Then message your bot
# once and visit https://api.telegram.org/bot<TOKEN>/getUpdates to find chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email digests over SMTP. For Gmail: enable 2-factor auth, then create an
# app password at https://myaccount.google.com/apppasswords and paste the
# 16 characters below (spaces are fine to remove). A normal account password
# will be rejected.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Defaults to SMTP_USER when blank. Comma-separated recipients are allowed.
EMAIL_FROM=
EMAIL_TO=

# ---- LLM (optional) -------------------------------------------------------
# Used to READ postings the hand-written skill vocabulary cannot parse, and to
# adjudicate ambiguous duplicates. It never produces a score -- the ranking
# stays deterministic and explainable. The system works fully without it
# (deterministic scoring + dedup stages 0-4).
#
# Any OpenAI-compatible endpoint works. Pick one:
#   Groq (free tier, fast)  https://api.groq.com/openai/v1   + LLM_API_KEY
#   Ollama (free, local)    http://localhost:11434/v1        no key needed
#   OpenRouter              https://openrouter.ai/api/v1     + LLM_API_KEY
#
# LLM_MODEL must name a model the chosen endpoint actually serves -- an
# Anthropic model name against Ollama's URL is a combination nothing answers.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_ENABLED=false
# Hard ceiling on LLM calls per search run, to bound cost.
LLM_MAX_CALLS_PER_RUN=120
# Seconds to wait on one completion. 120 suits a local 7B on CPU; a hosted
# model answers in seconds and only needs this to fail fast.
LLM_TIMEOUT_SECONDS=45

# An existing Anthropic key keeps working without editing anything else.
ANTHROPIC_API_KEY=

# ---- Job source credentials (all optional) --------------------------------
# Adzuna - free tier: https://developer.adzuna.com/  (best legal broad aggregator)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI - licensed Google Jobs / LinkedIn / Indeed reseller
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# SerpApi - Google Jobs results (paid): https://serpapi.com/
SERPAPI_KEY=

# USAJOBS - free: https://developer.usajobs.gov/APIRequest
# Requires BOTH the key and the email you registered with.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Jooble - free on request: https://jooble.org/api/about
JOOBLE_API_KEY=

# ---- Scheduler ------------------------------------------------------------
# Set to false when something outside the app owns the schedule -- the GitHub
# Actions workflow does, and a local dashboard pointed at the same database
# should not also be sending digests.
SCHEDULER_ENABLED=true
MORNING_DIGEST_ENABLED=true
MORNING_DIGEST_TIME=08:00
AFTERNOON_DIGEST_ENABLED=true
AFTERNOON_DIGEST_TIME=16:00
# all | weekdays
DIGEST_SCHEDULE=all

# ---- HTTP behaviour -------------------------------------------------------
HTTP_TIMEOUT_SECONDS=25
HTTP_MAX_RETRIES=3
HTTP_MAX_CONCURRENCY=12
# Per-host politeness delay in seconds
HTTP_RATE_LIMIT_DELAY=0.35
HTTP_CACHE_TTL_SECONDS=900
USER_AGENT=internship-search-agent/0.1 (personal job search; +contact via config)
